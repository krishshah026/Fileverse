{
  "name": "fileverse-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fileverse conversion API + workers",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/index.js",
    "test:fixtures": "bash test/make-fixtures.sh",
    "test:matrix": "node test/matrix.mjs --base ${FILEVERSE_URL:-http://localhost:8080}",
    "test:e2e": "node test/e2e.mjs --base ${FILEVERSE_URL:-http://localhost:8080}",
    "test:quality": "node test/quality.mjs --base ${FILEVERSE_URL:-http://localhost:8080}",
    "test:bigfile": "node test/bigfile.mjs ${FILEVERSE_URL:-http://localhost:8080}"
  },
  "dependencies": {
    "@tus/file-store": "^2.1.2",
    "@tus/server": "^2.4.7",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.3.0",
    "file-type": "^22.0.0",
    "js-yaml": "^4.1.1",
    "sharp": "^0.35.5",
    "smol-toml": "^1.5.2",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "tus-js-client": "^4.3.1"
  }
}
