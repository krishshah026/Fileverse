# Copy to .env next to docker-compose.yml and adjust.
DOMAIN=yourname.duckdns.org

# Keep files this long after a conversion (minutes).
FILE_TTL_MINUTES=120
# Per-file upload limit (MB). 20480 = 20 GB.
MAX_UPLOAD_MB=20480
# Chunk size for resumable uploads (MB). Keep below 100 when behind Cloudflare's free proxy.
UPLOAD_CHUNK_MB=50
# Disk space that must stay free after accepting an upload (MB).
DISK_RESERVE_MB=4096
# Parallel heavy (video, office, OCR) and light (images, data, PDF) jobs.
# On a 2-core server: 1 heavy + 2 light. On 4+ cores: cores/2 heavy, cores light.
HEAVY_CONCURRENCY=1
LIGHT_CONCURRENCY=2
