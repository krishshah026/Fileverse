# HTTPS certificates are obtained and renewed automatically for {$DOMAIN}.
{$DOMAIN} {
	# Compress only the web app's text assets (decided by the response type) — never uploads,
	# file downloads (which support HTTP range requests) or the live progress stream.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy fileverse:8080 {
		# Push live progress events (Server-Sent Events) immediately.
		flush_interval -1
	}
}
